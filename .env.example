# Copy to .env and fill in from your Supabase project:
#   Dashboard -> Project Settings -> Data API
#
# Both values are safe in the app bundle. The anon key is publishable by
# design -- row-level security is what protects the data, not the key's
# secrecy. Anything prefixed EXPO_PUBLIC_ is inlined into the JS bundle and
# readable by anyone with the app, so NEVER put the service_role key here.
#
# Leave these unset to run against the device-local account provider instead.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
